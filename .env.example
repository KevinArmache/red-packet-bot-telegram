# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Modèle de configuration du bot Cryptobox
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs.
# NE PARTAGEZ JAMAIS votre fichier .env !
# ──────────────────────────────────────────────────────────────────────────────

# ── Identifiants API Telegram ─────────────────────────────────────────────────
# Obtenez ces valeurs sur https://my.telegram.org → "API development tools"
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ── Numéro de téléphone associé au compte Telegram Userbot ───────────────────
# Format international avec indicatif pays (ex: +33 pour la France)
# ⚠️  Recommandé : utiliser un numéro secondaire dédié, pas votre numéro principal
PHONE_NUMBER=+33612345678

# ── Canaux Telegram à surveiller (séparés par des virgules, sans espaces) ─────
# Accepte : @pseudoCanal  ou  -1001234567890 (ID numérique avec -100 devant)
# Exemple avec plusieurs canaux : @canal1,@canal2,-1001234567890
TARGET_CHANNELS=@votre_canal_alertes,@autre_canal

# ── Timeout de connexion manuelle Binance (en millisecondes) ─────────────────
# Durée max d'attente pour que vous vous connectiez à Binance manuellement.
# 300000 = 5 minutes | 600000 = 10 minutes
BINANCE_LOGIN_TIMEOUT=300000
