# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Modèle de configuration du bot Cryptobox
# Copie ce fichier en .env et remplis-le avec tes vraies valeurs.
# L'app Android peut importer ce fichier : elle règle elle-même ce qui change
# sur le téléphone (rôle de secours, attente de connexion…).
# NE PARTAGE JAMAIS ton fichier .env !
# ──────────────────────────────────────────────────────────────────────────────

# ── Identifiants API Telegram ─────────────────────────────────────────────────
# Obtiens ces valeurs sur https://my.telegram.org → "API development tools"
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ── Numéro de téléphone associé au compte Telegram Userbot ───────────────────
# Format international avec indicatif pays (ex : +243 pour la RDC, +33 pour la France)
# ⚠️  Recommandé : utiliser un numéro secondaire dédié, pas ton numéro principal
PHONE_NUMBER=+33612345678

# ── Canaux Telegram à surveiller (séparés par des virgules) ──────────────────
# Accepte : @pseudoCanal, https://t.me/pseudoCanal ou -1001234567890 (ID
# numérique avec -100 devant : sans le -100, le canal ne serait pas écouté)
# Le compte doit être abonné à chaque canal : Telegram ne lui envoie que les
# messages des canaux qu'il a rejoints.
# Exemple avec plusieurs canaux : @canal1,@canal2,-1001234567890
TARGET_CHANNELS=@vgfboxes,@binance_box_channel,@cryptogws,@makzero,@rsbox,@red_packeta,@topcoinbox,@notes564,@RedHubIN,@KingBX,@bqbox,@BoxxSquare,@pkgoldtv5700,@SBDBOX,@SHEIKHBDBOX,@crypto_box_free_binance,@BinanceFBoxes


# ── Timeout de connexion manuelle Binance (en millisecondes) ─────────────────
# Durée max d'attente pour que tu te connectes à Binance manuellement, quand
# le navigateur démarre. Au-delà, le bot s'arrête.
# 300000 = 5 minutes | 600000 = 10 minutes
# 0 = attendre sans limite. C'est le réglage de l'app Android : elle t'attend
#     le temps que tu te connectes à Binance dans l'app.
# Une session qui expire en cours de route n'a pas de délai : le bot attend
# toujours ta reconnexion, sans tenter de code.
BINANCE_LOGIN_TIMEOUT=300000


# ══════════════════════════════════════════════════════════════════════════════
#  Alertes Telegram et relais PC ⇄ téléphone
# ══════════════════════════════════════════════════════════════════════════════

# ── Niveau des alertes ────────────────────────────────────────────────────────
# Les alertes passent par TON bot Telegram (voir ALERT_BOT_TOKEN) : ce sont de
# vraies notifications. Un message dans tes « Messages enregistrés » ne sonne pas.
#   off      = aucune alerte (valeur par défaut si la ligne manque)
#   problems = problèmes seulement : reconnexion Binance ou Telegram à faire,
#              pause anti-ban, navigateur planté, erreur fatale, redémarrage...
#   all      = problèmes + gains 💰, bot en ligne 🟢, relais 📱 / 😴, et bilan
#              quotidien 📊 (envoyé à minuit, il sert aussi de signe de vie)
NOTIFY_LEVEL=all

# ── Jeton de ton bot d'alertes ────────────────────────────────────────────────
# 1. Dans Telegram, ouvre @BotFather et envoie /newbot.
# 2. Donne-lui un nom, puis un identifiant qui finit par « bot ».
# 3. Colle ici le jeton qu'il te donne.
# 4. Ouvre ton nouveau bot et envoie-lui /start, une seule fois : sans ça,
#    Telegram lui interdit de t'écrire.
# Vide = alertes désactivées. ⚠️ Ce jeton est secret, comme tout ce fichier.
#
# 📌 Mon bot d'alertes : @redpacket_alert_termux_bot (🧧 Alertes Red Packet Termux)
#    Jeton oublié ? @BotFather → /mybots → @redpacket_alert_termux_bot → API Token
#    Jeton exposé ?  @BotFather → /revoke → nouveau jeton à remettre dans .env
#    ⛔ Le vrai jeton va UNIQUEMENT dans .env (jamais ici : ce fichier est public)
ALERT_BOT_TOKEN=

# ── Destinataire des alertes (facultatif) ─────────────────────────────────────
# Par défaut : toi. Ton identifiant Telegram est appris à la connexion et gardé
# dans .alert-chat-id. À remplir seulement pour un autre destinataire.
# ALERT_CHAT_ID=123456789

# ── Nom de cet appareil dans les alertes (facultatif) ────────────────────────
# Préfixe de chaque alerte (« 💻 PC · ... ») et nom affiché dans le message
# de relais. Par défaut : « 💻 PC », ou « 📱 Téléphone » quand BOT_ROLE=backup.
# BOT_NAME="🖥️ VPS"

# ── Rôle de cet appareil (relais PC ⇄ téléphone) ─────────────────────────────
# Le PC et le téléphone partagent le même compte Binance : un seul réclame à
# la fois, pour ne jamais soumettre deux fois le même code.
#   primary = PC prioritaire (défaut) : il réclame les codes et publie son état
#             toutes les 60 s dans UN message silencieux de tes « Messages
#             enregistrés » (#botrelay). Ne supprime pas ce message et ne le
#             modifie pas.
#   backup  = téléphone de secours : il réclame seulement quand le PC est
#             arrêté, pas prêt, ou muet depuis 2 min 30. Inutile de l'écrire
#             ici : l'app Android le règle toute seule sur le téléphone.
#   solo    = un seul appareil, aucune coordination, aucun message de relais.
BOT_ROLE=primary

# ── Healthcheck (facultatif, surtout pour le téléphone) ───────────────────────
# Adresse appelée au démarrage puis toutes les 5 min (ex. : un check gratuit
# healthchecks.io, période 5 min). Le service te prévient si les appels
# s'arrêtent (téléphone éteint, bot mort). Sur le téléphone, mets-la dans les
# réglages de l'app.
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ══════════════════════════════════════════════════════════════════════════════
#  📣 Publier tes gains sur ton canal Telegram
# ══════════════════════════════════════════════════════════════════════════════
# Chaque Red Packet gagné part tout de suite sur ton canal, avec son code
# (copiable d'une touche) et le montant, pour que tes abonnés le tentent aussi :
#   🧧 Red Packet réclamé !
#   🎁 Code : ABCD1234
#   💰 Gain : 0,52 USDT (≈ 0,52 $)
# C'est ton bot d'alertes (ALERT_BOT_TOKEN) qui publie : ton compte Telegram
# reste passif. Publie l'appareil qui a gagné : mets le même canal dans le .env
# du PC et dans les réglages du téléphone (📣 Publier mes gains).
#
# Le plus simple : le bot crée le canal pour toi, avec ton compte Telegram, y
# met ton bot d'alertes administrateur et écrit la ligne ci-dessous :
#   npm run channel -- --title "🧧 Mon canal" --username monCanal
# (ou, sur le téléphone : Réglages → 📣 Publier mes gains → ✨ Créer mon canal)
#
# Canal déjà existant :
# 1. Ouvre ton canal → Administrateurs → Ajouter un administrateur.
# 2. Cherche ton bot d'alertes (@…_bot) et laisse-lui « Publier des messages ».
# 3. Mets le canal ici, puis relance le bot. Au démarrage, la ligne
#    « 📣 @ton_bot peut publier sur @tonCanal » confirme (rien n'est publié).
#
# @pseudo, https://t.me/pseudo, ou l'ID -100… d'un canal privé.
# Vide (défaut) = rien n'est publié.
#
# 📌 Mon canal : @redpacketrdc_codes (🧧 Red Packet RDC, créé depuis l'app le 27/10/2026)
# PUBLISH_CHANNEL=@monCanal


# ══════════════════════════════════════════════════════════════════════════════
#  Anti-blocage Binance
# ══════════════════════════════════════════════════════════════════════════════
# Binance verrouille les Red Packets 5 h après 10 codes faux d'affilée (FAQ
# officielle). Le bot compte ces codes (recalé sur le nombre d'essais restants
# annoncé par Binance) et agit avant. Un code qui marche remet le compteur à 0.
# Code « clair » = publié en monospace, dans un lien Cryptobox ou après
# « Code : » (les codes en texte libre sont les plus souvent faux).
# Sur le téléphone : Réglages de l'app → 🛡️ Anti-blocage Binance.

# ── Mode ──────────────────────────────────────────────────────────────────────
#   stop  = garde-fou + arrêt ⛔ (défaut) : codes clairs seulement au premier
#           seuil, puis plus aucun code au second. Le 10e code faux n'est
#           jamais tapé. Reprise : réclame toi-même un code qui marche dans
#           l'app Binance, puis envoie #reprendre dans tes Messages enregistrés.
#   light = garde-fou léger seul : codes clairs seulement au seuil, sans
#           arrêt (le blocage de 5 h reste possible).
ANTIBAN_MODE=stop

# ── Codes clairs seulement à partir de N codes faux d'affilée ────────────────
# 0 à 9 | 0 = jamais
ANTIBAN_SELECTIVE_AT=8

# ── Arrêt total à partir de N codes faux d'affilée (mode stop) ───────────────
# Entre ANTIBAN_SELECTIVE_AT et 9 (10 = le blocage Binance, jamais permis)
ANTIBAN_STOP_AT=9

# ── Reprise automatique après l'arrêt ⛔ (en heures) ──────────────────────────
# 0 = manuelle (#reprendre). ⚠️ La reprise automatique suppose que Binance a
# remis son compteur à zéro tout seul : règle-la seulement après avoir vu
# l'alerte 🔄 « Compteur Binance revenu à zéro tout seul » dans les logs.
ANTIBAN_STOP_RESUME_H=0


# ══════════════════════════════════════════════════════════════════════════════
#  🐦 X (Twitter) — codes publiés sur X
# ══════════════════════════════════════════════════════════════════════════════
# Ni scraping ni API : le TÉLÉPHONE lit les notifications de l'appli X pour
# les comptes que tu suis avec la cloche « Tous les posts ». Les codes passent
# par les mêmes règles que Telegram (anti-blocage compris). Quand le PC
# réclame, le téléphone lui transmet chaque code par un message silencieux
# « #xcode … » dans tes Messages enregistrés (ne le supprime pas, il s'efface
# tout seul après 10 min).
# Sur le téléphone : Réglages de l'app → 🐦 X (Twitter).

# ── Lire les notifications de l'appli X (téléphone) ─────────────────────────
# true | false (défaut). Il faut aussi autoriser l'accès aux notifications.
# X_ENABLED=false

# ── Comptes X dont on lit les posts (séparés par des virgules) ──────────────
# Vide = tous les comptes avec la cloche, suggestions de X comprises : une
# liste est conseillée. Exemple : @binance,@binance_fr
# X_ACCOUNTS=

# ── Essai à blanc ───────────────────────────────────────────────────────────
# true = toute la chaîne tourne (détection, relais, anti-blocage) mais aucun
# code n'est tapé sur Binance : « 🧪 Essai à blanc » dans les logs. Les
# notifications de test envoyées par adb ne sont lues que dans ce mode.
# X_DRY_RUN=false

# ── PC : réclamer les codes X relayés par le téléphone ──────────────────────
# true (défaut) | false
# X_RELAY_ACCEPT=true


# ══════════════════════════════════════════════════════════════════════════════
#  🧧 Binance Square — Red Packets Quiz repérés sur Telegram
# ══════════════════════════════════════════════════════════════════════════════
# Des canaux publient un lien vers un post Binance Square et la réponse à son
# quiz, sans aucun code. Le bot les range dans l'onglet 🧧 Square de l'app. Il ne
# fait rien sur Binance : c'est toi qui ouvres le post et qui réponds (les règles
# de Square interdisent les bots). Quand tu touches « 🏆 Pris », le lien, sans le
# parrainage des autres, et la réponse partent sur ton canal (PUBLISH_CHANNEL).
# Sur le téléphone : Réglages de l'app → 🧧 Binance Square.

# ── Lire les liens Binance Square ───────────────────────────────────────────
# true (défaut) | false
# SQUARE_ENABLED=true

# ── Canaux de liens (séparés par des virgules) ──────────────────────────────
# Jamais lus comme des canaux de codes. Le compte doit y être abonné. Un lien
# Square publié dans TARGET_CHANNELS arrive aussi dans l'onglet 🧧 Square.
# SQUARE_CHANNELS=@Packet_Red


# ══════════════════════════════════════════════════════════════════════════════
#  Options avancées — toutes facultatives, les valeurs par défaut conviennent
# ══════════════════════════════════════════════════════════════════════════════

# ── Fraîcheur maximale d'un message (en secondes) ─────────────────────────────
# ⛔ Le bot ne réclame JAMAIS un code publié avant son démarrage (règle absolue).
# Ce réglage ajoute un garde-fou : un message livré en retard (après une coupure
# réseau) au-delà de ce délai est ignoré — son Red Packet est déjà vidé et le
# soumettre brûlerait une tentative Binance pour rien.
# 180 = 3 minutes | 0 = garde-fou désactivé
MAX_MESSAGE_AGE_S=180

# ── Groupes de discussion liés ────────────────────────────────────────────────
# Certains canaux publient les codes dans leur groupe de commentaires.
# true (défaut) = les explorer en arrière-plan | false = les ignorer
RESOLVE_LINKED_CHATS=true

# ── Bilan d'activité périodique (en minutes) ──────────────────────────────────
# Affiche un tableau récapitulatif dans la console (codes détectés, gains,
# latences, déconnexions...). 0 = désactivé (le bilan de minuit et celui de
# l'arrêt restent affichés)
STATS_INTERVAL_MIN=30

# ── Logs détaillés ────────────────────────────────────────────────────────────
# true = affiche le niveau 🔍 DEBUG (messages reçus, messages ignorés et
# pourquoi, alertes envoyées)
DEBUG=false

# ── Couleurs de la console ────────────────────────────────────────────────────
# Décommente pour désactiver les couleurs ANSI, même avec FORCE_COLOR=1.
# Elles sont déjà coupées automatiquement quand la sortie n'est pas un
# terminal (redirection vers un fichier, PM2, systemd).
# NO_COLOR=1

# ── Largeur des encadrés de la console (en colonnes) ─────────────────────────
# Largeur minimale des encadrés, séparateurs et tableaux, entre 32 et 120.
# Défaut : 64.
# LOG_WIDTH=64

# ── User-agent du navigateur ──────────────────────────────────────────────────
# Vide (défaut) = user-agent Chrome / Windows historique du bot.
# native        = celui du vrai Chromium (utile sous Linux, pour ne pas
#                 contredire les autres indices du navigateur).
# Toute autre valeur est utilisée telle quelle.
# BROWSER_USER_AGENT=native

# ── Autre Chromium ────────────────────────────────────────────────────────────
# Chemin d'un Chromium à utiliser à la place de celui de Playwright.
# CHROMIUM_PATH=/usr/bin/chromium

# ── Options Chromium supplémentaires (séparées par des espaces) ──────────────
# ⚠️ Jamais --disable-features (ça écraserait la liste de Playwright).
# Plusieurs options : mets-les entre guillemets.
# CHROMIUM_EXTRA_ARGS=--disable-gpu
